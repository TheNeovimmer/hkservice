             \"<i class='fa-solid fa-circle-chevron-right' style='color: #d4af37; font-size: 35px;'></i>\",\n                ], // Texte des flèches\n                autoplay: true, // Défilement automatique\n                autoplayTimeout: 5000, // Temps entre les défilements en ms\n                autoplayHoverPause: true, // Pause sur survol\n            });\n        });\n    </script>\n\n    <script>\n        // script.js\n\n        window.onload = function () {\n            const popup = document.getElementById(\"popup\");\n            const popupContent = document.querySelector(\".popup-content\");\n\n            popup.style.display = \"flex\";\n\n            setTimeout(() => {\n                popup.classList.add(\"show\");\n                popupContent.classList.add(\"show\");\n            }, 10);\n        };\n\n        // Fonction pour fermer le popup et rediriger vers la section \"événement\"\n        function closePopupAndRedirect() {\n            const popup = document.getElementById(\"popup\");\n            const popupContent = document.querySelector(\".popup-content\");\n\n            popup.classList.remove(\"show\");\n            popupContent.classList.remove(\"show\");\n\n            setTimeout(() => {\n                popup.style.display = \"none\";\n                // Rediriger vers la section \"événement\"\n                window.location.href = \"#evenement\";\n            }, 500);\n        }\n\n        function closePopup() {\n            const popup = document.getElementById(\"popup\");\n            const popupContent = document.querySelector(\".popup-content\");\n\n            popup.classList.remove(\"show\");\n            popupContent.classList.remove(\"show\");\n\n            setTimeout(() => {\n                popup.style.display = \"none\";\n            }, 500);\n        }\n\n        // Attacher l'événement au bouton pour fermer le popup et rediriger\n        document.querySelector(\".close-btn\").onclick = closePopup;\n\n        // Optionnel : Fermer le popup si l'utilisateur clique en dehors\n        window.onclick = function (event) {\n            if (event.target == document.getElementById(\"popup\")) {\n                closePopupAndRedirect();\n            }\n        };\n    </script>\n\n    <script>\n        $(document).ready(function () {\n            $(\".owl-carousel\").owlCarousel({\n                loop: true,\n                margin: 10,\n                nav: true,\n                responsive: {\n                    0: {\n                        items: 1\n                    },\n                    600: {\n                        items: 2\n                    },\n                    1000: {\n                        items: 3\n                    }\n                }\n            });\n        });\n    </script>\n</body>\n\n\n</html>\n\n\n\n\n\n\n       \n\n        "
