       <div class=\"link-box\">\n                            <div class=\"call-us\">\n                                <a class=\"link\" href=\"tel:+330605682407\">\n                                    <span class=\"icon\"></span>\n                                    <span class=\"sub-text\">Appelez à tout moment</span>\n                                    <span class=\"number\">+330605682407</span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n          </div>\n      </div>\n      <!--End Header Upper-->\n    </header>\n    <!-- End Main Header -->\n\n    <!--Mobile Menu-->\n    <div class=\"side-menu__block\">\n      <div class=\"side-menu__block-overlay custom-cursor__overlay\">\n        <div class=\"cursor\"></div>\n        <div class=\"cursor-follower\"></div>\n      </div>\n      <!-- /.side-menu__block-overlay -->\n      <div class=\"side-menu__block-inner\">\n        <div class=\"side-menu__top justify-content-end\">\n          <a href=\"#\" class=\"side-menu__toggler side-menu__close-btn\"><img src=\"images/icons/close-1-1.html\"\n              alt=\"\" /></a>\n        </div>\n        <!-- /.side-menu__top -->\n\n        <nav class=\"mobile-nav__container\">\n          <!-- content is loading via js -->\n        </nav>\n        <div class=\"side-menu__sep\"></div>\n        <!-- /.side-menu__sep -->\n        <div class=\"side-menu__content\">\n          <p>\n            H&K Services est une Société franco-tunisienne de construction spécialisée dans les projets résidentiels et commerciaux.\n          </p>\n          <p>\n            <a href=\"mailto:contact@H&K Services.com\">contact@H&K Services.com</a>\n            <br />\n            <a href=\"tel:+330605682407\">+330605682407</a>\n          </p>\n        </div>\n        <!-- /.side-menu__content -->\n      </div>\n      <!-- /.side-menu__block-inner -->\n    </div>\n    <!-- /.side-menu__block -->\n\n    <!--Search Popup-->\n    <div class=\"search-popup\">\n      <div class=\"search-popup__overlay custom-cursor__overlay\">\n        <div class=\"cursor\"></div>\n        <div class=\"cursor-follower\"></div>\n      </div>\n      <!-- /.search-popup__overlay -->\n      <div class=\"search-popup__inner\">\n        <form action=\"#\" class=\"search-popup__form\">\n          <input type=\"text\" name=\"search\" placeholder=\"Entrez ici pour rechercher....\" />\n          <button type=\"submit\"><i class=\"fa fa-search\"></i></button>\n        </form>\n      </div>\n      <!-- /.search-popup__inner -->\n    </div>\n    <!-- /.search-popup -->\n\n    <!-- Banner Section -->\n    <section class=\"page-banner\">\n      <div class=\"image-layer\" style=\"background-image: url('img/gallery/img5.jpg')\"></div>\n      <div class=\"shape-1\"></div>\n      <div class=\"shape-2\"></div>\n      <div class=\"banner-inner\">\n        <div class=\"auto-container\">\n          <div class=\"inner-container clearfix\">\n            <h1>Contactez-nous</h1>\n            <div class=\"page-nav\">\n              <ul class=\"bread-crumb clearfix\">\n                <li><a href=\"index-2.html\">Page d'accueil</a></li>\n                <li class=\"active\">Contact</li>\n              </ul>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n    <!--End Banner Section -->\n\n    <!--Contact Section-->\n    <section class=\"contact-section contact-two\">\n      <div class=\"auto-container\">\n        <div class=\"row\">\n          <div class=\"col-lg-4\">\n            <div class=\"contact-two__content\">\n              <div class=\"sec-title\">\n                <h2>Avez-vous un projet de construction en tête ?<span class=\"dot\">.</span></h2>\n              </div>\n              <p class=\"contact-two__text\">\n                 H&K Services vous accompagne dans la réalisation de vos idées avec professionnalisme, qualité et expertise.\n                 Notre équipe est à votre disposition pour répondre à toutes vos demandes d’information, établir un devis personnalisé ou vous conseiller dans chaque étape de votre projet.\n                 N’hésitez pas à nous contacter pour donner vie à vos projets en toute confiance.\n              </p>\n            </div>\n            <!-- /.contact-two__content -->\n          </div>\n          <!-- /.col-lg-4 -->\n          <div class=\"col-lg-8\">\n            <div class=\"form-box\">\n              <div class=\"default-form\">\n                <form id=\"contact-form\">\n                  <div class=\"row clearfix\">\n                    <!-- Informations Générales -->\n                    <div class=\"col-lg-12\">\n                      <h3 class=\"section-title\">Informations Générales :</h3>\n                    </div>\n\n                    <div class=\"form-group col-lg-6 col-md-6 col-sm-12\">\n                      <div class=\"field-inner\">\n                        <input type=\"text\" name=\"from_name\" id=\"from_name\"\n                          placeholder=\"Nom de la société / Nom du client\" required />\n                      </div>\n                    </div>\n\n                    <div class=\"form-group col-lg-6 col-md-6 col-sm-12\">\n                      <div class=\"field-inner\">\n                        <input type=\"email\" name=\"email_id\" id=\"email_id\" placeholder=\"Adresse e-mail\" />\n                      </div>\n                    </div>\n\n                    <div class=\"form-group col-lg-6 col-md-6 col-sm-12\">\n                      <div class=\"field-inner\">\n                        <input type=\"number\" name=\"tel\" id=\"tel\" placeholder=\"Numéro de téléphone\" required />\n                      </div>\n                    </div>\n\n                    <div class=\"form-group col-lg-6 col-md-6 col-sm-12\">\n                      <div class=\"field-inner\">\n                        <input type=\"text\" name=\"Lieu\" id=\"Lieu\"\n                          placeholder=\"Adresse du projet (lieu de construction)\" />\n                      </div>\n                    </div>\n\n                    <!-- Type de Projet -->\n                    <div class=\"col-lg-12\">\n                      <div class=\"field-inner\">\n                        <h3 class=\"section-title\">Type de Projet :</h3>\n                      </div>\n                    </div>\n\n                    <div class=\"form-group col-lg-4 col-md-4 col-sm-4\">\n                      <div class=\"field-inner\">\n                        <label class=\"checkbox-label\">\n                          <input type=\"checkbox\" name=\"service\" value=\"Nouvelle construction\" />\n                          <span class=\"checkbox-custom\"></span>\n                          Nouvelle construction\n                        </label>\n                      </div>\n                    </div>\n\n                    <div class=\"form-group col-lg-4 col-md-4 col-sm-4\">\n                      <div class=\"field-inner\">\n                        <label class=\"checkbox-label\">\n                          <input type=\"checkbox\" name=\"service\" value=\"Rénovation / Extension\"\n                            id=\"renovation-extension\" />\n                          <span class=\"checkbox-custom\"></span>\n                          Rénovation / Extension\n                        </label>\n                      </div>\n                    </div>\n\n                    <div class=\"form-group col-lg-4 col-md-4 col-sm-4\">\n                      <div class=\"field-inner\">\n                        <label class=\"checkbox-label\">\n                          <input type=\"checkbox\" name=\"service\" value=\"Aménagement intérieur\"\n                            id=\"amenagement-interieur\" />\n                          <span class=\"checkbox-custom\"></span>\n                          Aménagement intérieur\n                        </label>\n                      </div>\n                    </div>\n\n                    <!-- Terrain -->\n                    <div class=\"col-lg-12\">\n                      <h3 class=\"section-title\">Terrain :</h3>\n                    </div>\n\n                    <div class=\"form-group col-lg-6 col-md-6 col-sm-12\">\n                      Propriétaire du terrain :\n                      <div class=\"field-inner\">\n                        <label class=\"checkbox-label\">\n                          <input type=\"checkbox\" name=\"proprietaire_terrain\" value=\"Oui\" />\n                          <span class=\"checkbox-custom\"></span>\n                          Oui\n                        </label>\n                        <label class=\"checkbox-label\">\n                          <input type=\"checkbox\" name=\"proprietaire_terrain\" value=\"Non\" />\n                          <span class=\"checkbox-custom\"></span>\n                          Non\n                        </label>\n                      </div>\n                    </div>\n\n                    <div class=\"form-group col-lg-6 col-md-6 col-sm-12\">\n                      <div class=\"field-inner\">\n                        <input type=\"text\" name=\"adresse_terrain\" id=\"adresse_terrain\"\n                          placeholder=\"Adresse du terrain\" />\n                      </div>\n                    </div>\n\n                    <div class=\"form-group col-lg-6 col-md-6 col-sm-12\">\n                      <div class=\"field-inner\">\n                        <input type=\"number\" name=\"superficie_terrain\" id=\"superficie_terrain\"\n                          placeholder=\"Superficie du terrain (m²)\" />\n                      </div>\n                    </div>\n\n                    <div class=\"form-group col-lg-6 col-md-6 col-sm-12\">\n                      <div class=\"field-inner\">\n                        <input type=\"text\" name=\"statut_administratif\" id=\"statut_administratif\"\n                          placeholder=\"Statut administratif (prêt à construire, en cours de validation ...)\" />\n                      </div>\n                    </div>\n\n                    <!-- En cas de construction existante -->\n                    <div class=\"col-lg-12\" id=\"existing-construction\" style=\"display: none;\">\n                      <h3 class=\"section-title\">En cas de construction existante :</h3>\n                    </div>\n\n                    <div class=\"form-group col-lg-6 col-md-6 col-sm-12\" id=\"existing-construction-details\"\n                      style=\"display: none;\">\n                      <div class=\"field-inner\">\n                        <input type=\"text\" name=\"nature_batiment\" id=\"nature_batiment\"\n                          placeholder=\"Nature du bâtiment existant (maison, immeuble, local commercial ...)\" />\n                      </div>\n                    </div>\n\n                    <div class=\"form-group col-lg-6 col-md-6 col-sm-12\" id=\"existing-construction-details\"\n                      style=\"display: none;\">\n                      <div class=\"field-inner\">\n                        <input type=\"number\" name=\"annee_construction\" id=\"annee_construction\"\n                          placeholder=\"Année de construction\" />\n                      </div>\n                    </div>\n\n                    <div class=\"form-group col-lg-6 col-md-6 col-sm-12\" id=\"existing-construction-details\"\n                      style=\"display: none;\">\n                      <div class=\"field-inner\">\n                        <input type=\"number\" name=\"superficie_actuelle\" id=\"superficie_actuelle\"\n                          placeholder=\"Superficie actuelle (m²)\" />\n                      </div>\n                    </div>\n\n                    <!-- Détails Techniques -->\n                    <div class=\"col-lg-12\">\n                      <h3 class=\"section-title\">Détails Techniques :</h3>\n                    </div>\n\n                    <div class=\"form-group col-lg-6 col-md-6 col-sm-12\">\n                      <div class=\"field-inner\">\n                        <input type=\"text\" name=\"type_construction\" id=\"type_construction\"\n                          placeholder=\"Type de construction (Résidentiel, commercial, industriel ...)\" />\n                      </div>\n                    </div>\n\n                    <div class=\"form-group col-lg-6 col-md-6 col-sm-12\">\n                      <div class=\"field-inner\">\n                        <input type=\"text\" name=\"budget_estime\" id=\"budget_estime\" placeholder=\"Budget estimé\" />\n                      </div>\n                    </div>\n\n                    <div class=\"form-group col-lg-6 col-md-6 col-sm-12\">\n                      <div class=\"field-inner\">\n                        <input type=\"text\" name=\"delais_souhaite\" id=\"delais_souhaite\"\n                          placeholder=\"Délais souhaités (date de début et de fin)\" />\n                      </div>\n                    </div>\n\n                    <!-- Message -->\n                    <div class=\"form-group col-lg-12 col-md-12 col-sm-12\">\n                      <div class=\"field-inner\">\n                        <textarea name=\"message\" placeholder=\"Message\"></textarea>\n                      </div>\n                    </div>\n\n                    <!-- Button -->\n                    <div class=\"form-group col-lg-12 col-md-12 col-sm-12\">\n                      <button class=\"theme-btn btn-style-one\">\n                        <i class=\"btn-curve\"></i>\n                        <span class=\"btn-title\">Envoyer</span>\n                      </button>\n                    </div>\n                  </div>\n                </form>\n              </div>\n            </div>\n          </div>\n\n\n\n          <!-- /.col-lg-8 -->\n        </div>\n        <!-- /.row -->\n      </div>\n    </section>\n\n    <!-- <section class=\"contact-info-two\">\n        <div cl