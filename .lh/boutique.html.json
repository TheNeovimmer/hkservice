            "name": "Commit-0",
            "content": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"title\" content=\"Boutique Matériaux - H&K Services\" />\n  <meta name=\"description\" content=\"Boutique en ligne de matériaux de construction H&K Services. Ciment, peinture, plomberie, outillage - Prix TND et EUR.\" />\n  <title>Boutique Matériaux | H&K Services</title>\n\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com/\" />\n  <link href=\"https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&amp;family=Teko:wght@300;400;500;600;700&amp;display=swap\" rel=\"stylesheet\" />\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\" />\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css\" />\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css\" />\n\n  <style>\n    /* ===== H&K Services Theme Overrides ===== */\n    :root {\n      --hk-gold: #d4af37;\n      --hk-gold-dark: #b8962f;\n      --hk-dark: #1a1a2e;\n      --hk-darker: #0f0f1a;\n      --hk-card-bg: #1e1e36;\n      --hk-text: #e0e0e0;\n      --hk-text-muted: #9a9ab0;\n      --hk-border: rgba(212, 175, 55, 0.2);\n      --hk-radius: 12px;\n      --hk-transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n    }\n\n    body {\n      font-family: 'Rubik', sans-serif;\n      background: var(--hk-darker);\n      color: var(--hk-text);\n      overflow-x: hidden;\n    }\n\n    /* ===== Header (H&K style) ===== */\n    .main-header {\n      background: var(--hk-dark);\n      border-bottom: 2px solid var(--hk-border);\n    }\n    .header-upper .logo-box .logo img {\n      max-height: 60px;\n    }\n    .header-upper .nav-outer .main-menu .navigation > li > a {\n      color: var(--hk-text) !important;\n      font-weight: 500;\n      transition: var(--hk-transition);\n    }\n    .header-upper .nav-outer .main-menu .navigation > li > a:hover {\n      color: var(--hk-gold) !important;\n    }\n    .header-upper .other-links .call-us .link {\n      color: var(--hk-text);\n    }\n    .header-upper .other-links .call-us .link .number {\n      color: var(--hk-gold);\n    }\n\n    /* ===== Page Header ===== */\n    .page-header {\n      position: relative;\n      padding: 140px 0 60px;\n      background: linear-gradient(135deg, var(--hk-darker) 0%, var(--hk-dark) 100%);\n      text-align: center;\n      border-bottom: 1px solid var(--hk-border);\n    }\n    .page-header h1 {\n      font-family: 'Teko', sans-serif;\n      font-size: 3.5rem;\n      font-weight: 600;\n      color: #fff;\n      text-transform: uppercase;\n      letter-spacing: 2px;\n    }\n    .page-header h1 span { color: var(--hk-gold); }\n    .page-header p {\n      color: var(--hk-text-muted);\n      font-size: 1.1rem;\n      margin-top: 8px;\n    }\n\n    /* ===== Section ===== */\n    .section-shop {\n      padding: 60px 0 80px;\n    }\n\n    /* ===== Filter ===== */\n    .filter-bar {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 10px;\n      justify-content: center;\n      margin-bottom: 40px;\n    }\n    .filter-btn {\n      padding: 8px 22px;\n      border-radius: 50px;\n      font-size: .85rem;\n      font-weight: 500;\n      color: var(--hk-text-muted);\n      background: transparent;\n      border: 1px solid var(--hk-border);\n      transition: var(--hk-transition);\n      font-family: 'Rubik', sans-serif;\n    }\n    .filter-btn:hover {\n      border-color: var(--hk-gold);\n      color: var(--hk-gold);\n    }\n    .filter-btn.active {\n      background: var(--hk-gold);\n      border-color: var(--hk-gold);\n      color: var(--hk-dark);\n      font-weight: 600;\n    }\n\n    /* ===== Product Card ===== */\n    .product-card {\n      background: var(--hk-card-bg);\n      border-radius: var(--hk-radius);\n      border: 1px solid var(--hk-border);\n      overflow: hidden;\n      transition: var(--hk-transition);\n      display: flex;\n      flex-direction: column;\n      height: 100%;\n    }\n    .product-card:hover {\n      transform: translateY(-4px);\n      border-color: var(--hk-gold);\n      box-shadow: 0 8px 30px rgba(212, 175, 55, 0.15);\n    }\n    .product-card.hidden { display: none; }\n\n    .product-image {\n      height: 200px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      background: rgba(255,255,255,0.03);\n      position: relative;\n      overflow: hidden;\n    }\n    .product-image .product-emoji {\n      font-size: 4.5rem;\n      transition: transform .4s ease;\n      line-height: 1;\n    }\n    .product-card:hover .product-emoji {\n      transform: scale(1.1) rotate(-3deg);\n    }\n    .product-badge {\n      position: absolute;\n      top: 12px;\n      left: 12px;\n      padding: 4px 14px;\n      border-radius: 50px;\n      font-size: .7rem;\n      font-weight: 600;\n      text-transform: uppercase;\n      letter-spacing: .5px;\n      font-family: 'Rubik', sans-serif;\n    }\n    .badge-nouveau { background: #10b981; color: #fff; }\n    .badge-promotion { background: var(--hk-gold); color: var(--hk-dark); }\n    .badge-populaire { background: #6366f1; color: #fff; }\n\n    .product-body { padding: 20px; flex: 1; display: flex; flex-direction: column; }\n    .product-category {\n      font-size: .75rem;\n      font-weight: 600;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n      color: var(--hk-gold);\n      margin-bottom: 4px;\n    }\n    .product-name {\n      font-size: 1.1rem;\n      font-weight: 600;\n      color: #fff;\n      margin-bottom: 6px;\n    }\n    .product-desc {\n      font-size: .85rem;\n      color: var(--hk-text-muted);\n      line-height: 1.5;\n      margin-bottom: 14px;\n      flex: 1;\n    }\n\n    /* Colors */\n    .product-colors {\n      display: flex;\n      gap: 8px;\n      margin-bottom: 14px;\n      align-items: center;\n      flex-wrap: wrap;\n    }\n    .color-label {\n      font-size: .75rem;\n      color: var(--hk-text-muted);\n      margin-right: 4px;\n    }\n    .color-swatch {\n      width: 26px;\n      height: 26px;\n      border-radius: 50%;\n      border: 2px solid transparent;\n      cursor: pointer;\n      transition: var(--hk-transition);\n      position: relative;\n      flex-shrink: 0;\n    }\n    .color-swatch:hover { transform: scale(1.15); }\n    .color-swatch.active {\n      border-color: var(--hk-gold);\n      box-shadow: 0 0 0 2px var(--hk-card-bg), 0 0 0 4px var(--hk-gold);\n    }\n    .color-swatch::after {\n      content: attr(data-tooltip);\n      position: absolute;\n      bottom: calc(100% + 6px);\n      left: 50%;\n      transform: translateX(-50%) scale(.8);\n      background: #333;\n      color: #fff;\n      padding: 2px 8px;\n      border-radius: 4px;\n      font-size: .65rem;\n      white-space: nowrap;\n      opacity: 0;\n      pointer-events: none;\n      transition: var(--hk-transition);\n    }\n    .color-swatch:hover::after {\n      opacity: 1;\n      transform: translateX(-50%) scale(1);\n    }\n\n    /* Pricing */\n    .product-pricing {\n      display: flex;\n      align-items: baseline;\n      gap: 12px;\n      margin-bottom: 16px;\n      padding: 10px 14px;\n      background: rgba(255,255,255,0.04);\n      border-radius: 8px;\n      border: 1px solid rgba(255,255,255,0.06);\n    }\n    .price-tnd {\n      font-size: 1.3rem;\n      font-weight: 700;\n      color: #fff;\n    }\n    .price-eur {\n      font-size: .85rem;\n      font-weight: 500;\n      color: var(--hk-text-muted);\n    }\n    .price-eur::before { content: '~ '; }\n\n    /* Add to cart */\n    .add-to-cart {\n      width: 100%;\n      padding: 12px;\n      background: var(--hk-gold);\n      color: var(--hk-dark);\n      font-weight: 600;\n      border-radius: 8px;\n      transition: var(--hk-transition);\n      font-size: .9rem;\n      border: none;\n      font-family: 'Rubik', sans-serif;\n      cursor: pointer;\n    }\n    .add-to-cart:hover {\n      background: var(--hk-gold-dark);\n      transform: translateY(-1px);\n    }\n    .add-to-cart:active { transform: scale(.97); }\n\n    /* ===== Cart Sidebar ===== */\n    .cart-overlay {\n      position: fixed;\n      inset: 0;\n      z-index: 9999;\n      background: rgba(0,0,0,.6);\n      backdrop-filter: blur(6px);\n      opacity: 0;\n      pointer-events: none;\n      transition: var(--hk-transition);\n    }\n    .cart-overlay.open { opacity: 1; pointer-events: auto; }\n\n    .cart-sidebar {\n      position: fixed;\n      top: 0;\n      right: 0;\n      z-index: 10000;\n      width: 420px;\n      max-width: 100vw;\n      height: 100vh;\n      background: var(--hk-card-bg);\n      border-left: 1px solid var(--hk-border);\n      display: flex;\n      flex-direction: column;\n      transform: translateX(100%);\n      transition: transform .4s cubic-bezier(.4,0,.2,1);\n    }\n    .cart-sidebar.open { transform: translateX(0); }\n\n    .cart-header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 20px 24px;\n      border-bottom: 1px solid var(--hk-border);\n    }\n    .cart-header h3 {\n      font-family: 'Teko', sans-serif;\n      font-size: 1.6rem;\n      color: #fff;\n      margin: 0;\n    }\n    .cart-close {\n      width: 36px; height: 36px;\n      display: flex;\n      align-items: center; justify-content: center;\n      border-radius: 50%;\n      font-size: 1.5rem;\n      color: var(--hk-text-muted);\n      background: none;\n      border: none;\n      cursor: pointer;\n      transition: var(--hk-transition);\n    }\n    .cart-close:hover { background: rgba(255,255,255,0.05); color: #fff; }\n\n    .cart-body { flex: 1; overflow-y: auto; padding: 16px 24px; }\n\n    .cart-empty {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100%;\n      text-align: center;\n      color: var(--hk-text-muted);\n    }\n    .cart-empty-icon { font-size: 3rem; margin-bottom: 12px; }\n    .cart-empty p { font-weight: 600; color: var(--hk-text); }\n    .cart-empty small { font-size: .8rem; }\n\n    .cart-item {\n      display: flex;\n      gap: 14px;\n      padding: 14px 0;\n      border-bottom: 1px solid var(--hk-border);\n    }\n    .cart-item-img {\n      width: 60px; height: 60px;\n      border-radius: 8px;\n      background: rgba(255,255,255,0.05);\n      display: flex; align-items: center; justify-content: center;\n      font-size: 1.6rem;\n      flex-shrink: 0;\n    }\n    .cart-item-info { flex: 1; min-width: 0; }\n    .cart-item-name {\n      font-weight: 600; font-size: .9rem;\n      color: #fff;\n      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n    }\n    .cart-item-color {\n      font-size: .75rem; color: var(--hk-text-muted);\n      margin-bottom: 6px;\n    }\n    .cart-item-bottom {\n      display: flex; align-items: center; justify-content: space-between;\n    }\n    .cart-item-qty {\n      display: flex; align-items: center;\n      border: 1px solid var(--hk-border);\n      border-radius: 6px; overflow: hidden;\n    }\n    .qty-btn {\n      width: 30px; height: 30px;\n      display: flex; align-items: center; justify-content: center;\n      font-size: 1rem; font-weight: 600;\n      color: var(--hk-text); background: none; border: none; cursor: pointer;\n      transition: var(--hk-transition);\n    }\n    .qty-btn:hover { background: rgba(255,255,255,0.05); color: var(--hk-gold); }\n    .qty-value {\n      width: 32px; text-align: center;\n      font-size: .85rem; font-weight: 600; color: #fff;\n    }\n    .cart-item-total { font-weight: 700; font-size: .9rem; color: var(--hk-gold); }\n    .cart-item-remove {\n      color: var(--hk-text-muted); font-size: .8rem;\n      background: none; border: none; cursor: pointer;\n      transition: var(--hk-transition); padding: 4px 8px;\n    }\n    .cart-item-remove:hover { color: #ef4444; }\n\n    .cart-footer {\n      padding: 20px 24px;\n      border-top: 1px solid var(--hk-border);\n      background: rgba(0,0,0,.2);\n    }\n    .cart-total-row {\n      display: flex; justify-content: space-between; align-items: center;\n      margin-bottom: 8px; font-size: .9rem; color: var(--hk-text-muted);\n    }\n    .cart-total-row:last-of-type { margin-bottom: 16px; }\n    .cart-total { font-weight: 700; font-size: 1.1rem; color: var(--hk-gold); }\n    .btn-cart-checkout {\n      width: 100%;\n      padding: 14px;\n      background: var(--hk-gold);\n      color: var(--hk-dark);\n      border: none;\n      border-radius: 8px;\n      font-weight: 700;\n      font-size: 1rem;\n      cursor: pointer;\n      transition: var(--hk-transition);\n      font-family: 'Rubik', sans-serif;\n    }\n    .btn-cart-checkout:hover { background: var(--hk-gold-dark); }\n\n    /* ===== Cart Icon in Header ===== */\n    .cart-icon-btn {\n      position: relative;\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      color: var(--hk-text) !important;\n      font-size: .95rem;\n      padding: 6px 14px;\n      border: 1px solid var(--hk-border);\n      border-radius: 8px;\n      transition: var(--hk-transition);\n      background: none;\n      cursor: pointer;\n      font-family: 'Rubik', sans-serif;\n    }\n    .cart-icon-btn:hover {\n      border-color: var(--hk-gold);\n      color: var(--hk-gold) !important;\n    }\n    .cart-icon-btn .cart-count-badge {\n      position: absolute;\n      top: -6px;\n      right: -6px;\n      width: 20px;\n      height: 20px;\n      background: var(--hk-gold);\n      color: var(--hk-dark);\n      font-size: .65rem;\n      font-weight: 700;\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      transform: scale(0);\n      transition: transform .35s cubic-bezier(.34,1.56,.64,1);\n    }\n    .cart-icon-btn .cart-count-badge.show { transform: scale(1); }\n\n    /* ===== Toast ===== */\n    .toast-shop {\n      position: fixed;\n      bottom: 24px;\n      left: 50%;\n      transform: translateX(-50%) translateY(80px);\n      z-index: 99999;\n      padding: 14px 28px;\n      border-radius: 8px;\n      background: var(--hk-card-bg);\n      border: 1px solid var(--hk-border);\n      color: #fff;\n      font-weight: 500;\n      font-size: .9rem;\n      box-shadow: 0 10px 40px rgba(0,0,0,.4);\n      opacity: 0;\n      transition: all .4s cubic-bezier(.4,0,.2,1);\n      pointer-events: none;\n    }\n    .toast-shop.show { opacity: 1; transform: translateX(-50%) translateY(0); }\n    .toast-shop.success { border-color: #10b981; }\n    .toast-shop.error { border-color: #ef4444; }\n\n    /* ===== Section Title ===== */\n    .sec-title-shop {\n      text-align: center;\n      margin-bottom: 40px;\n    }\n    .sec-title-shop h2 {\n      font-family: 'Teko', sans-serif;\n      font-size: 2.8rem;\n      font-weight: 600;\n      color: #fff;\n      text-transform: uppercase;\n    }\n    .sec-title-shop h2 span { color: var(--hk-gold); }\n    .sec-title-shop p {\n      color: var(--hk-text-muted);\n      font-size: 1.05rem;\n      margin-top: 4px;\n    }\n\n    /* ===== Products Grid ===== */\n    .products-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n      gap: 24px;\n    }\n\n    /* ===== Footer ===== */\n    .main-footer {\n      background: var(--hk-dark);\n      border-top: 2px solid var(--hk-border);\n      padding: 50px 0 0;\n    }\n    .main-footer .logo-widget .logo img { max-height: 60px; }\n    .main-footer .widget-content .text {\n      color: var(--hk-text-muted);\n      font-size: .9rem;\n      margin-top: 12px;\n    }\n    .main-footer .contact-info li {\n      color: var(--hk-text);\n      margin-bottom: 10px;\n    }\n    .main-footer .contact-info li a {\n      color: var(--hk-text-muted);\n      text-decoration: none;\n      transition: var(--hk-transition);\n    }\n    .main-footer .contact-info li a:hover { color: var(--hk-gold); }\n    .main-footer .contact-info li .icon { color: var(--hk-gold); margin-right: 8px; }\n    .main-footer .footer-widget__links li { margin-bottom: 8px; }\n    .main-footer .footer-widget__links li a {\n      color: var(--hk-text-muted);\n      text-decoration: none;\n      transition: var(--hk-transition);\n    }\n    .main-footer .footer-widget__links li a:hover { color: var(--hk-gold); }\n    .footer-bottom {\n      border-top: 1px solid var(--hk-border);\n      padding: 20px 0;\n      margin-top: 30px;\n    }\n    .footer-bottom .copyright {\n      color: var(--hk-text-muted);\n      font-size: .85rem;\n      text-align: center;\n    }\n\n    /* ===== Responsive ===== */\n    @media (max-width: 768px) {\n      .page-header h1 { font-size: 2.4rem; }\n      .products-grid { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }\n      .cart-sidebar { width: 100%; }\n      .sec-title-shop h2 { font-size: 2rem; }\n      .filter-bar { gap: 8px; }\n      .filter-btn { font-size: .8rem; padding: 6px 14px; }\n    }\n    @media (max-width: 480px) {\n      .products-grid { grid-template-columns: 1fr; }\n    }\n  </style>\n</head>\n<body>\n\n<div class=\"page-wrapper\">\n\n  <!-- ===== HEADER (H&K Services style) ===== -->\n  <!-- Main Header -->\n        <header class=\"main-header header-style-one\">\n            <!-- Header Upper -->\n            <div class=\"header-upper\">\n                <div class=\"inner-container clearfix\">\n                    <!--Logo-->\n                    <div class=\"logo-box\">\n                        <div class=\"logo\">\n                            <a href=\"index-2.html\" title=\"H&K Services\"><img\n                                    src=\"img\\logo png\\Logo.png\" id=\"thm-logo\"\n                                    alt=\"Logo de l'entreprise de construction H&K Services\"\n                                    title=\"H&K Services\" /></a>\n                        </div>\n                    </div>\n                    <div class=\"nav-outer clearfix\">\n                        <!--Mobile Navigation Toggler-->\n                        <div class=\"mobile-nav-toggler\">\n                            <span class=\"icon flaticon-menu-2\"></span><span class=\"txt\">Menu</span>\n                        </div>\n\n                        <!-- Main Menu -->\n                        <nav class=\"main-menu navbar-expand-md navbar-light\">\n                            <div class=\"collapse navbar-collapse show clearfix\" id=\"navbarSupportedContent\">\n                                <ul class=\"navigation clearfix\">\n                                    <li>\n                                        <a href=\"index-2.html\">Accueil</a>\n                                    </li>\n\n                                    <li class=\"dropdown\">\n                                        <a href=\"services-construction.html\">Nos Services</a>\n                                        <ul>\n                                            <li>\n                                                <a href=\"services-construction.html#etude\">Construction de Maisons </a>\n                                            </li>\n                                            <li>\n                                                <a href=\"services-construction.html#Construction\">Peinture et Décoration\n                                                </a>\n                                            </li>\n                                            <li>\n                                                <a href=\"services-construction.html#Gestion\">Maintenance Générale\n                                                </a>\n                                            </li>\n                                        </ul>\n                                    </li>\n\n                                    <li>\n                                        <a href=\"projets-construction-batiments.html\">Projets</a>\n                                    </li>\n                                    <li>\n                                        <a href=\"catalogue-construction.html\">E-Catalogue</a>\n                                    </li>\n                                    <li>\n                                        <a href=\"societe-batiment.html\">Qui Sommes Nous</a>\n                                    </li>\n                                    <li>\n                                        <a href=\"boutique.html\">boutique</a>\n                                    </li>\n\n                                    <li>\n                                        <a href=\"contact.html\">Contactez-nous</a>\n                                    </li>\n                                </ul>\n                            </div>\n                        </nav>\n                    </div>\n\n                    <div class=\"other-links clearfix\">\n                        <!--Social Links-->\n                        <div class=\"link-box\">\n                            <div class=\"call-us\">\n                                <a class=\"link\" href=\"tel:+330605682407\">\n                                    <span class=\"icon\"></span>\n                                    <span class=\"sub-text\">Appelez à tout moment</span>\n                                    <span class=\"number\">+330605682407</span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!--End Header Upper-->\n        </header>\n        <!-- End Main Header -->\n\n        <!-- Popup Window -->\n\n        <!--Mobile Menu-->\n        <div class=\"side-menu__block\">\n    