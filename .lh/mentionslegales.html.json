pup-content\");\n\n            popup.classList.remove(\"show\");\n            popupContent.classList.remove(\"show\");\n\n            setTimeout(() => {\n                popup.style.display = \"none\";\n            }, 500);\n        }\n\n        // Attacher l'événement au bouton pour fermer le popup et rediriger\n        document.querySelector(\".close-btn\").onclick = closePopup;\n\n        // Optionnel : Fermer le popup si l'utilisateur clique en dehors\n        window.onclick = function (event) {\n            if (event.target == document.getElementById(\"popup\")) {\n                closePopupAndRedirect();\n            }\n        };\n    </script>\n\n    <script>\n        $(document).ready(function () {\n            $(\".owl-carousel\").owlCarousel({\n                loop: true,\n                margin: 10,\n                nav: true,\n                responsive: {\n                    0: {\n                        items: 1\n                    },\n                    600: {\n                        items: 2\n                    },\n                    1000: {\n                        items: 3\n                    }\n                }\n            });\n        });\n    </script>\n</body>\n<!-- Mirrored from leaders-building.com/politique.html by HTTrack Website Copier/3.x [XR&CO'2014], Thu, 07 May 2026 10:03:30 GMT -->\n\n</html>\n\n\n\n\n\n\n       \n\n        "
